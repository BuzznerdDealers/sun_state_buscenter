{
  "$schema": "./tokens.schema.json",
  "version": 2,
  "fonts": {
    "heading": "INTL Headline",
    "body": "INTL Text",
    "files": [
      { "family": "INTL Headline", "url": "/fonts/INTLHeadline-Light.woff2", "weight": "300", "style": "normal" },
      { "family": "INTL Headline", "url": "/fonts/INTLHeadline-Regular.woff2", "weight": "400", "style": "normal" },
      { "family": "INTL Headline", "url": "/fonts/INTLHeadline-Medium.woff2", "weight": "500", "style": "normal" },
      { "family": "INTL Headline", "url": "/fonts/INTLHeadline-Bold.woff2", "weight": "600 900", "style": "normal" },
      { "family": "INTL Text", "url": "/fonts/INTLText-Light.woff2", "weight": "300", "style": "normal" },
      { "family": "INTL Text", "url": "/fonts/INTLText-LightItalic.woff2", "weight": "300", "style": "italic" },
      { "family": "INTL Text", "url": "/fonts/INTLText-Regular.woff2", "weight": "400", "style": "normal" },
      { "family": "INTL Text", "url": "/fonts/INTLText-RegularItalic.woff2", "weight": "400", "style": "italic" },
      { "family": "INTL Text", "url": "/fonts/INTLText-Medium.woff2", "weight": "500", "style": "normal" },
      { "family": "INTL Text", "url": "/fonts/INTLText-MediumItalic.woff2", "weight": "500", "style": "italic" },
      { "family": "INTL Text", "url": "/fonts/INTLText-Bold.woff2", "weight": "600 900", "style": "normal" },
      { "family": "INTL Text", "url": "/fonts/INTLText-BoldItalic.woff2", "weight": "600 900", "style": "italic" }
    ]
  },
  "colors": {
    "accent": "#F7C600",
    "accentDark": "#8A6D00",
    "ink": "#1A1714",
    "inkDark": "#1A1714",
    "muted": "#6B6354",
    "line": "#E1DACB",
    "card": "#FFFFFF",
    "paper": "#FAF8F4"
  },
  "status": {
    "ok": "#157347",
    "info": "#3a5ea8",
    "warn": "#B45309",
    "bad": "#B03A32"
  },
  "type": {
    "h1": 52,
    "h2": 36,
    "h3": 28,
    "body": 15,
    "small": 14,
    "eyebrow": 12
  },
  "typography": {
    "headingWeight": 700,
    "bodyWeight": 400,
    "headingLineHeight": 1.15,
    "bodyLineHeight": 1.5
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "radius": { "nav": 7, "input": 10, "card": 14, "modal": 16, "chip": 999 },
  "layout": { "container": "1440px", "padDesktop": 24, "padTablet": 24, "padMobile": 16 }
}
