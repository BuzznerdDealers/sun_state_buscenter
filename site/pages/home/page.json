                {
                  "id": "fin-t",
                  "type": "text",
                  "props": {
                    "text": "Competitive rates on new and used buses, tailored to single-route operators and district fleets alike.",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "fin-cta",
              "type": "column",
              "props": {
                "span": 4,
                "align": "end"
              },
              "children": [
                {
                  "id": "fin-btn",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "get-pre-qualified"
                      }
                    ],
                    "align": "left"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "testimonials",
      "type": "sharedSection",
      "props": {
        "sectionId": "quote-rotator",
        "values": {
          "eyebrow": "Customers",
          "heading": "What Fleet Owners Say",
          "quotes": [
            {
              "quote": "They kept three of our buses down for less than 48 hours combined all year. That's the difference a good service team makes.",
              "name": "Marcus Webb",
              "role": "Transportation Director, Hillsborough County"
            },
            {
              "quote": "Financing was straightforward and the team walked us through every option for our first electric CE Series.",
              "name": "Dana Ortiz",
              "role": "Fleet Manager, Ortiz Student Transport"
            },
            {
              "quote": "Parts counter always has what we need in stock, or it ships next day. Huge for uptime.",
              "name": "Ray Callahan",
              "role": "Operations Lead, Callahan Charter"
            }
          ]
        }
      }
    },
