{
  "version": 2,
  "nodes": [
    {
      "id": "hero",
      "type": "section",
      "props": {
        "width": "wide",
        "paddingY": 10,
        "background": "ink",
        "align": "center"
      },
      "styles": {
        "base": {
          "backgroundImage": "/images/hero-bus.jpg",
          "backgroundSize": "cover",
          "backgroundPosition": "center",
          "minHeight": "70vh",
          "position": "relative"
        }
      },
      "children": [
        {
          "id": "hero-row",
          "type": "row",
          "props": {
            "gap": 7,
            "align": "center",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "hero-copy",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "hero-title",
                  "type": "heading",
                  "props": {
                    "eyebrow": "New & Used School Buses",
                    "text": "Florida's Premier IC Bus Dealer",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "hero-lede",
                  "type": "text",
                  "props": {
                    "text": "Sun State Bus Centers is the exclusive IC Bus sales, parts, and service dealer for the state of Florida. IC Bus school buses come with a range of power options to fit your fleet.",
                    "width": "full"
                  }
                },
                {
                  "id": "hero-search",
                  "type": "widget",
                  "props": {
                    "widget": "inventory-search",
                    "config": {
                      "placeholder": "Search by stock #, model, or VIN"
                    }
                  }
                }
              ]
            },
            {
              "id": "hero-actions",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "hero-tiles",
                  "type": "action-tiles",
                  "props": {
                    "tiles": [
                      {
                        "label": "New Buses",
                        "url": "/store/inventory?condition=new",
                        "icon": {
                          "src": "/images/icon-bus.svg",
                          "alt": "New Buses icon"
                        }
                      },
                      {
                        "label": "Used Buses",
                        "url": "/store/inventory?condition=used",
                        "icon": {
                          "src": "/images/icon-bus.svg",
                          "alt": "Used Buses icon"
                        }
                      },
                      {
                        "label": "Schedule Service",
                        "url": "/#service",
                        "icon": {
                          "src": "/images/icon-service.svg",
                          "alt": "Schedule Service icon"
                        }
                      },
                      {
                        "label": "Order Parts",
                        "url": "/#parts",
                        "icon": {
                          "src": "/images/icon-parts.svg",
                          "alt": "Order Parts icon"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inventory",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 9,
        "background": "card",
        "anchor": "inventory"
      },
      "children": [
        {
          "id": "inv-head",
          "type": "row",
          "props": {
            "gap": 4
          },
          "children": [
            {
              "id": "inv-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "inv-title",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Inventory",
                    "text": "Featured Listings",
                    "headingLevel": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "inv-list",
          "type": "widget",
          "props": {
            "widget": "inventory-carousel",
            "config": {
              "limit": 4
            }
          }
        },
        {
          "id": "inv-more",
          "type": "buttons",
          "props": {
            "items": [
              {
                "ctaId": "view-all-inventory"
              }
            ],
            "align": "left"
          }
        }
      ]
    },
    {
      "id": "about",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 10,
        "background": "ink",
        "anchor": "about"
      },
      "children": [
        {
          "id": "about-title",
          "type": "heading",
          "props": {
            "eyebrow": "Why Sun State",
            "text": "What We Offer",
            "headingLevel": 2,
            "align": "center"
          }
        },
        {
          "id": "about-band",
          "type": "statBand",
          "props": {
            "stats": [
              {
                "value": "180+",
                "label": "Service Technicians"
              },
              {
                "value": "250+",
                "label": "Service Bays"
              },
              {
                "value": "50",
                "label": "Parts Delivery Vehicles"
              },
              {
                "value": "12+",
                "label": "Certified FDOE Bus Safety Inspectors"
              },
              {
                "value": "AC",
                "label": "Factory Trained AC Technicians"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "service",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 9,
        "background": "card",
        "anchor": "service"
      },
      "children": [
        {
          "id": "sp-row",
          "type": "row",
          "props": {
            "gap": 8,
            "align": "start",
            "stackOn": "tablet"
