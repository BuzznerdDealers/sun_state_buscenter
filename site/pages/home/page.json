                  "props": {
                    "image": {
                      "src": "/images/service-bus.jpg",
                      "alt": "IC Bus school bus with its stop arm extended"
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "sp-service-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Service Center",
                    "text": "Certified Maintenance & Repair",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "sp-service-t",
                  "type": "text",
                  "props": {
                    "text": "Factory-trained technicians, genuine parts, and same-week appointments to keep your fleet on the road longer.",
                    "width": "full"
                  }
                },
                {
                  "id": "sp-service-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "schedule-service"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "sp-parts",
              "type": "column",
              "props": {
                "span": 6,
                "anchor": "parts"
              },
              "children": [
                {
                  "id": "sp-parts-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/images/parts-bus.jpg",
                      "alt": "Fleet of school buses parked in a row"
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "sp-parts-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Parts Department",
                    "text": "OEM Parts, In Stock",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "sp-parts-t",
                  "type": "text",
                  "props": {
                    "text": "Order online or call our parts desk. Most in-stock orders ship same day.",
                    "width": "full"
                  }
                },
                {
                  "id": "sp-parts-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "order-parts"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "financing",
      "type": "section",
      "props": {
        "width": "wide",
        "paddingY": 8,
        "background": "accent",
        "anchor": "financing"
      },
      "children": [
        {
          "id": "fin-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "center",
            "stackOn": "mobile"
